# SMTP mailbox that sends Employee Login OTP emails (see vite-plugins/employeeAuthPlugin.ts /
# api/_lib/routes/employeeAuthRequestOtp.ts). A dedicated shared mailbox, not any one employee's
# own inbox. If it has MFA/Modern Auth enabled, SMTP_PASSWORD must be an app password, not the
# regular login password — and the Microsoft 365 tenant must have SMTP AUTH enabled for it.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
